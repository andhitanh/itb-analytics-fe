BACKEND_DEV_URL=


# Base URL backend API yang dipakai axios di browser.
# Dev  : biarkan kosong → request /api/* di-proxy oleh Vite ke BACKEND_DEV_URL
# Prod : diisi di .env.production atau di-inject oleh CI/CD
VITE_API_URL=


# Path endpoint SSO login Microsoft.
# Hanya perlu diubah jika routing backend berubah.
VITE_AUTH_LOGIN_PATH=
